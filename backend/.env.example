# Copy to .env and adjust. Every value is optional; defaults are shown.
PORT=5000
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Comma-separated allow-list. Leave empty in development to reflect any origin.
CORS_ORIGINS=
# Set to 1 when behind a reverse proxy / Cloud Run so rate limiting sees real client IPs.
TRUST_PROXY=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Credentials: by default backend/serviceAccountKey.json is used if present,
# otherwise Application Default Credentials (GOOGLE_APPLICATION_CREDENTIALS).
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=
